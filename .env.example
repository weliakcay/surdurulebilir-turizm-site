# Bu dosyayı .env.local olarak kopyalayıp doldurun. .env.local git'e GİRMEZ.
# cp .env.example .env.local

# ── Site ────────────────────────────────────────────────────────────
# Vercel deploy adresiniz. HTTPS olmak ZORUNDA — LinkedIn linki buradan üretilir.
NEXT_PUBLIC_SITE_URL=https://surdurulebilir-turizm.vercel.app

# ── LinkedIn app (developer.linkedin.com → My Apps → Auth) ──────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# LinkedIn redirect URI'nin HTTPS olmasını şart koşar; localhost çalışmaz.
# Bu adresin app'in "Authorized redirect URLs" listesinde BİREBİR kayıtlı olması gerekir.
LINKEDIN_REDIRECT_URI=https://surdurulebilir-turizm.vercel.app/api/linkedin/callback

# ── Yayın hedefi ────────────────────────────────────────────────────
# "kisi"        → kişisel profile post atar. "Share on LinkedIn" ürünü yeter
#                 (w_member_social), self-servis, hemen çalışır.
# "organizasyon"→ şirket sayfasına post atar. Community Management API ürünü
#                 gerekir (w_organization_social), LinkedIn incelemesinden geçer.
LINKEDIN_HEDEF=kisi

# Hedef "organizasyon" ise zorunlu. Bulmak için: npm run linkedin:durum
LINKEDIN_ORGANIZATION_URN=

# Hedef "kisi" ise boş bırakın — /v2/userinfo ile otomatik bulunur.
# LINKEDIN_PERSON_URN=urn:li:person:

# ── İsteğe bağlı ────────────────────────────────────────────────────
# Scope'lar hedefe göre değişir:
#   kisi         → "openid profile w_member_social"
#   organizasyon → "w_organization_social r_organization_social"
# LINKEDIN_SCOPE=openid profile w_member_social

# API sürümü (YYYYMM). LinkedIn eski sürümleri periyodik kapatır.
# LINKEDIN_API_VERSION=202607

# Developer Portal Token Generator ile üretilmiş token'ı doğrudan kullanmak için.
# Ayarlıysa .linkedin-token.json yok sayılır.
# LINKEDIN_ACCESS_TOKEN=
